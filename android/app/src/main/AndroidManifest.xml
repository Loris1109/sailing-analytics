<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
<!-- BLE ab Android 12 (API 31) -->
<uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
<uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
<uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
<!-- BLE bis Android 11. Die drei Berechtigungen darüber gibt es dort noch
     nicht; ohne diese beiden bleibt Bluetooth auf älteren Geräten stumm.
     maxSdkVersion, damit Android 12+ sie gar nicht erst anfragt — dort
     gelten die neuen. Das Standortrecht, das ein BLE-Scan bis Android 11
     zusätzlich braucht, hat die App ohnehin. -->
<uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
<uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
<!-- permisson for GPS -->
<uses-permission android:name="android.permission.INTERNET" />
<!-- Beide, nicht nur FINE: seit Android 12 ignoriert das System eine Anfrage
     nach dem genauen Standort, wenn COARSE nicht mitdeklariert ist. -->
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
<!-- flutter_ble_peripheral deklariert dieselben zwei Rechte noch einmal als
     <uses-permission-sdk-23> mit maxSdkVersion="30". Das ist ein anderes
     XML-Element, der Merger führt es deshalb NICHT mit den Zeilen darüber
     zusammen — beim Installieren zählt Android aber beide als dieselbe
     Berechtigung. Play lehnt das Bundle dann ab: "Duplicate declarations …
     with different maxSdkVersions".
     Die Zeilen der Bibliothek können ersatzlos weg: unsere gelten ohne
     Obergrenze und auf allen API-Ständen, sind also strikt weiter gefasst. -->
<uses-permission-sdk-23
    android:name="android.permission.ACCESS_FINE_LOCATION"
    tools:node="remove" />
<uses-permission-sdk-23
    android:name="android.permission.ACCESS_COARSE_LOCATION"
    tools:node="remove" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
<!-- Ab Android 13 nötig, damit die Benachrichtigung des Vordergrunddienstes
     überhaupt sichtbar wird. Der Dienst läuft auch ohne sie weiter, aber
     dann sieht niemand, dass aufgezeichnet wird. -->
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
<!-- Für enableWakeLock in der foregroundNotificationConfig (gps_service.dart).
     Ohne sie wirft der Positionsstream beim Start eine PlatformException und
     es kommt kein einziger Fix an — nicht etwa nur kein Wakelock.
     wakelock_plus bringt sie NICHT mit: das hält den Bildschirm über ein
     Fensterflag wach und braucht deshalb keine Berechtigung. -->
<uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:label="Tacktics"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
